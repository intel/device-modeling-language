Group: dmllib(name)
  $(HOST)/bin/dml/{name}.dml
  $(HOST)/bin/dml/{name}.dmlast

Group: dml-1.2-reference-manual
Require-tokens: public
Make: doc-dml-1.2-reference-manual
  @doc-files(dml-1.2-reference-manual)

Group: dml-1.4-reference-manual
Require-tokens: public
Make: doc-dml-1.4-reference-manual
  @doc-files(dml-1.4-reference-manual)

