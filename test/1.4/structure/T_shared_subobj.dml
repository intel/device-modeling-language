dml 1.4;

device test;

template t1 {
    shared method m1() -> (int) { return 1; }
}

template t2 {
    param p: int;
    shared group g is t1 {
        param q = p + 1;
        shared method m2() -> (int) { return 2; }
        method m3() -> (int) { return 3; }
    }
}

group a is t2 {
    param p = 4;
}

// the implicit template of an overriding declaration must outrank the one it
// overrides
template x {
    shared group g {
        shared method m() -> (int) default { return 5; }
    }
}

template y is x {
    shared group g {
        shared method m() -> (int) { return 6; }
    }
}

group b is y;

// a diamond: the node c.g instantiates d1.g, d2.g and d3.g at once
template d1 {
    shared group g {
        shared method m1() -> (int) default { return 1; }
    }
}

template d2 is d1 {
    shared group g {
        shared method m2() -> (int) { return 2; }
    }
}

template d3 is d1 {
    shared group g {
        shared method m3() -> (int) { return 3; }
    }
}

group c is (d2, d3);

// nested: n.g.h instantiates n1.g.h and n2.g.h
template n1 {
    shared group g {
        shared group h {
            shared method m() -> (int) default { return 7; }
        }
    }
}

template n2 is n1 {
    shared group g {
        shared group h {
            shared method m() -> (int) { return 8; }
        }
    }
}

group n is n2;

// the implicit template inherits the template of the object type
template r {
    shared register reg size 1 @ 0 {
        shared method twice() -> (uint64) { return get() * 2; }
    }
}

bank bk {
    group rg is r;
}

// all declarations of an object in one template body form its implicit
// template, as soon as one of them is shared
param cond = true;
template m {
    shared group g {
        shared method m1() -> (int) { return 1; }
    }
    shared group g {
        shared method m2() -> (int) { return m1() + s; }
    }
    group g {
        session int s = 2;
    }
    #if (cond) {
        group g {
            param p = 3;
        }
    }
}

group mg is m;

// the implicit template is a member of the enclosing template type, and is
// resolved through it, also via a typedef
typedef t2 t2_alias;
template tm {
    param pg: t2.g;
    shared method get_g() -> (t2_alias.g) { return pg; }
}
group tmo is tm {
    param pg = cast(a.g, t2.g);
}

method init() {
    local t2 t = cast(a, t2);
    assert t.g.m1() == 1;
    assert t.g.m2() == 2;
    // non-shared members and params stay reachable on the object
    assert a.g.m3() == 3;
    assert a.g.q == 5;

    assert cast(b, x).g.m() == 6;

    assert cast(c, d1).g.m1() == 1;
    assert c.g.m2() == 2;
    assert c.g.m3() == 3;

    assert cast(n, n1).g.h.m() == 8;

    local r rr = cast(bk.rg, r);
    rr.reg.set(3);
    assert rr.reg.twice() == 6;

    assert cast(mg, m).g.m2() == 3;
    assert mg.g.p == 3;

    local t2.g tg = t.g;
    assert tg.m2() == 2;
    assert cast(tmo, tm).get_g() == tg;
    local n1.g.h nh = cast(n, n1).g.h;
    assert nh.m() == 8;
}
