method bar() default { }
/// ERROR ENAMECOLL
method bar() default { }

typedef struct {
    /// ERROR ENAMECOLL
    int i;
    /// ERROR ENAMECOLL
    int i;
} strange_struct;

loggroup g;
/// ERROR ENAMECOLL
loggroup g;

bank b {
    /// ERROR ENAMECOLL
    register x[i < 4] size 1 @ i;
    /// ERROR ENAMECOLL
    group x[i < 4];
}

port p0 {
    /// ERROR ENAMECOLL
    param foo = 1;
    /// ERROR ENAMECOLL
    param foo = 1;
