template clashing_shared_methods {
    /// ERROR ENAMECOLL
    shared method m() default {}
    /// ERROR ENAMECOLL
    shared method m() default {}

    /// ERROR ENAMECOLL
    param i: int;
    /// ERROR ENAMECOLL
