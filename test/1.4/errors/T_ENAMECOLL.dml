    /// ERROR ENAMECOLL
    param pm: int;
    /// ERROR ENAMECOLL
    shared method pm() default {}

    /// ERROR ENAMECOLL
    session int ses;
    /// ERROR ENAMECOLL
    session int ses;
}

// a method cannot override a parameter, and a parameter cannot override
// anything.
template abstract_param {
    /// ERROR ENAMECOLL
    param p0: int;
}
template shared_method_override is abstract_param {
    /// ERROR ENAMECOLL
    shared method p0();
}
template method_override is abstract_param {
    /// ERROR ENAMECOLL
    method p0() {}
}
template param_override is abstract_param {
    /// ERROR ENAMECOLL
    param p0: int;
}
group po is method_override { param p0 = 1; }
template abstract_method {
    /// ERROR ENAMECOLL
    shared method am();
    /// ERROR ENAMECOLL
    shared method dm() default {}
    /// ERROR ENAMECOLL
    shared method dm2() default {}
    /// ERROR ENAMECOLL
    session int ses;
}
template param_override2 is abstract_method {
    /// ERROR ENAMECOLL
    param am: int;
    /// ERROR ENAMECOLL
    param dm: int;
    /// ERROR ENAMECOLL
    session int dm2;
    /// ERROR ENAMECOLL
    session int ses;
}
template param_untyped_override is abstract_method {
    /// ERROR ENAMECOLL
    param am = 5;
    /// ERROR ENAMECOLL
    param dm = 6;
}

group gg is param_untyped_override;

template sm {
    /// ERROR ENAMECOLL
    shared method m() default {}
}

template p_clash {
    /// ERROR ENAMECOLL
    param p default 1;
    /// ERROR ENAMECOLL
    param p default 2;
}
// does not hide the error
group p_clash is p_clash { param p = 3; }

bank tb is sm {
    /// ERROR ENAMECOLL
    register m size 1 @ 0;
}

// a `shared` object declaration occupies one name for both the object and the
// template parameter, so any other member of that name clashes
template shared_group {
    /// ERROR ENAMECOLL
    shared group g;
}
group shared_group_clash is shared_group {
    /// ERROR ENAMECOLL
    session int g;
}
group so_objtype_clash is shared_group {
    /// ERROR ENAMECOLL
    event g;
}
group so_param_clash is shared_group {
    /// ERROR ENAMECOLL
    param g default 1;
}
group so_noclash_group is shared_group {
    // no error
    group g;
}

// the collision leaves the trait parameter without a value, so the object must
// be abandoned rather than have its vtables initialized
template so_vtable {
    /// ERROR ENAMECOLL
    shared group g { shared method m() -> (int) { return 1; } }
    shared method n() -> (int) { return g.m(); }
}
group so_vtable_clash is so_vtable {
    /// ERROR ENAMECOLL
    session int g;
}
// no crash
/// ERROR EIDENT
param so_p = so_vtable_clash;

// a shared object may only override an inherited shared object
template so_inh {
    param g1: int;
    shared method g2() {}
    session int g3;
}
template so_inh_clash is so_inh {
    /// ERROR ENAMECOLL
    shared group g1;
    /// ERROR ENAMECOLL
    shared group g2;
    /// ERROR ENAMECOLL
    shared group g3;
}

/// ERROR ENAMECOLL
group ga[i < 4][i < 4];

method m1() { }
method m2() { }

/// ERROR ENAMECOLL
export m1 as "m_dup";
/// ERROR ENAMECOLL
export m2 as "m_dup";

template param_clash {
    /// ERROR ENAMECOLL
    param overridden_clash default 1;
    /// ERROR ENAMECOLL
    param overridden_clash default 1;
}
group param_clash_override is param_clash {
    param overridden_clash = 1;
}

method init() {
    local layout "little-endian" {
        /// ERROR ENAMECOLL
        uint32 a;
        /// ERROR ENAMECOLL
        uint32 a;
    } x;
    x.a = 4;

    local bitfields 32 {
        /// ERROR ENAMECOLL
        uint16 a @ [15:0];
        /// ERROR ENAMECOLL
        uint16 a @ [31:16];
    } y;
    y.a = 4;
}
