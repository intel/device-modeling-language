dml 1.4;
device test;

/// DMLC-FLAG --enable-features-for-internal-testing-dont-use-this

template t {
    /// WARNING WEXPERIMENTAL
    shared hook() h[5][3];

    shared method sm() {
        /// ERROR EARRAY
        h.send_now();
        /// ERROR EARRAY
        h[0].send_now();
        // no error
        h[0][0].send_now();
    }
}

is t;

template ts {
    shared group g[i < 5][j < 3] { shared method m() {} }

    shared method sm() {
        /// ERROR EARRAY
        g.m();
        /// ERROR EARRAY
        g[0].m();
        // no error
        g[0][0].m();
    }
}

group gs is ts;

method init() {
    /// ERROR EARRAY
    cast(dev, t).h.send_now();
    /// ERROR EARRAY
    cast(dev, t).h[0].send_now();
    // no error
    cast(dev, t).h[0][0].send_now();
    /// ERROR EARRAY
    cast(gs, ts).g[0].m();
    // no error
    cast(gs, ts).g[0][0].m();
}
