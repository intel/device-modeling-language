dml 1.4;

device test;

/// ERROR ETYPE
extern undefined_type_t undef_ret();
/// ERROR ETYPE
extern void undef_arg(undefined_type_t);
/// ERROR ETYPE
extern undefined_type undef_val;
/// ERROR ETYPE
typedef undefined_type_t undef_ret();
/// ERROR ETYPE
extern typedef void undef_arg(undefined_type_t);
/// ERROR ETYPE
extern typedef undefined_type undef_val;

template t {
    /// ERROR ETYPE
    shared hook(undefined_type) h;
    /// ERROR ETYPE
    session undefined_type ses;
    /// ERROR ETYPE
    saved undefined_type sav;
    /// ERROR ETYPE
    param p : undefined_type;

    shared method m(
        // no error
        bool a,
        /// ERROR ETYPE
        undefined_type b)
        /// ERROR ETYPE
        -> (undefined_type);
    shared method n(
        // no error
        bool a,
        /// ERROR ETYPE
        undefined_type b)
        /// ERROR ETYPE
        -> (undefined_type) {
        assert false;
    }
    shared method o(
        // no error
        bool a,
        /// ERROR ETYPE
        undefined_type b)
        /// ERROR ETYPE
        -> (undefined_type) default {
        assert false;
    }
}

template u is t {
    shared method o(
        // no error
        bool a,
        /// ERROR ETYPE
        undefined_type b)
        /// ERROR ETYPE
        -> (undefined_type) {
        assert false;
    }
}

// a member type must name a shared object of a template type
template tm {
    shared group g {
        group notshared;
        shared group sub;
    }
}
typedef int tm_int;
template tm_user {
    /// ERROR ETYPE
    session undefined_type.g s3;
    /// ERROR ETYPE
    session tm_int.g s2;
    /// ERROR ETYPE
    session tm.nosuch s1;
    /// ERROR ETYPE
    session tm.g.nosuch s4;
    /// ERROR ETYPE
    session tm.g.notshared s5;
    // no error
    session tm.g.sub s6;
}
